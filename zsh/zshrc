# l0th1-dot-env: zsh entrypoint. Sourced by the ~/.zshrc stub that `l0th1 install` writes.
#
# Layers load from lowest to highest precedence:
#   public   zsh/core -> zsh/os/<os> -> zsh/profiles/<profile>...
#   overlay  zsh/common -> zsh/profiles/<profile>... -> zsh/hosts/<host>
#            for each private overlay repo in L0TH1_OVERLAYS, in order
#   machine  ~/.config/l0th1/local            (unmanaged: secrets, one-off tweaks)
#
# Every layer is an optional directory that may contain:
#   functions/    one autoloaded function per file. A later layer overrides by name.
#   bin/          executables put on PATH (usable from scripts, nohup, sudo).
#   plugins.txt   antidote bundle lines. All layers' files are merged into one bundle.
#   *.zsh         sourced in lexical order, after every layer's functions are on fpath.

: ${L0TH1_CONFIG:=${XDG_CONFIG_HOME:-$HOME/.config}/l0th1}
[[ -r $L0TH1_CONFIG/machine.zsh ]] && source $L0TH1_CONFIG/machine.zsh

L0TH1_PUBLIC=${${(%):-%x}:A:h:h}
: ${L0TH1_HOST:=${HOST%%.*}}
: ${L0TH1_PROFILES:=}
: ${L0TH1_OVERLAYS:=}    # colon-separated overlay repo paths, e.g. personal and identifai
: ${L0TH1_DATA:=${XDG_DATA_HOME:-$HOME/.local/share}/l0th1}
: ${L0TH1_CACHE:=${XDG_CACHE_HOME:-$HOME/.cache}/l0th1}
: ${L0TH1_STATE:=${XDG_STATE_HOME:-$HOME/.local/state}/l0th1}
case $OSTYPE in
  darwin*) L0TH1_OS=darwin ;;
  linux*)  L0TH1_OS=linux ;;
  *)       L0TH1_OS=other ;;
esac
# Exported so vim (and child shells) see the same machine identity.
export L0TH1_CONFIG L0TH1_PUBLIC L0TH1_OVERLAYS L0TH1_HOST L0TH1_PROFILES L0TH1_OS

typeset -ga L0TH1_LAYERS L0TH1_PLUGIN_FILES
() {
  local p layer overlay
  local -a fns
  L0TH1_LAYERS=( $L0TH1_PUBLIC/zsh/core $L0TH1_PUBLIC/zsh/os/$L0TH1_OS )
  for p in ${=L0TH1_PROFILES}; do L0TH1_LAYERS+=( $L0TH1_PUBLIC/zsh/profiles/$p ); done
  for overlay in ${(s.:.)L0TH1_OVERLAYS}; do
    L0TH1_LAYERS+=( $overlay/zsh/common )
    for p in ${=L0TH1_PROFILES}; do L0TH1_LAYERS+=( $overlay/zsh/profiles/$p ); done
    L0TH1_LAYERS+=( $overlay/zsh/hosts/$L0TH1_HOST )
  done
  L0TH1_LAYERS+=( $L0TH1_CONFIG/local )
  L0TH1_LAYERS=( ${^L0TH1_LAYERS}(N/) )

  # Pass 1: put functions on fpath, bin/ on PATH and collect plugin lists. Each
  # layer is prepended, so the highest-precedence layer is found first by name.
  L0TH1_PLUGIN_FILES=()
  for layer in $L0TH1_LAYERS; do
    if [[ -d $layer/functions ]]; then
      fpath=( $layer/functions $fpath )
      fns=( $layer/functions/*(N.:t) )
      fns=( ${fns:#_*} )               # _foo files are completions; compinit loads them
      (( $#fns )) && autoload -Uz $fns
    fi
    [[ -d $layer/bin ]] && path=( $layer/bin $path )
    [[ -r $layer/plugins.txt ]] && L0TH1_PLUGIN_FILES+=( $layer/plugins.txt )
  done
}

# Pass 2: source layer scripts at top level so they behave like a normal zshrc.
for _l0th1_f in ${^L0TH1_LAYERS}/*.zsh(N.); do
  source $_l0th1_f
done
unset _l0th1_f

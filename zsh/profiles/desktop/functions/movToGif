# movToGif <file.mov>: 30fps, 320px-wide GIF with an optimised palette.
local palette=$(mktemp -t palette.XXXXXX).png
local filters="fps=30,scale=320:-1:flags=lanczos"
local dest=${1%.mov}.gif
ffmpeg -v warning -i "$1" -vf "$filters,palettegen" -y $palette &&
  ffmpeg -v warning -i "$1" -i $palette -lavfi "$filters [x]; [x][1:v] paletteuse" -y "$dest"
rm -f $palette

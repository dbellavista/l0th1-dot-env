#!/usr/bin/env zsh
# l0th1: install, update and inspect the l0th1-dot-env setup on this machine.
# Run `l0th1 help` for usage.

emulate -R zsh
setopt extended_glob pipe_fail

SELF=${0:A}
L0TH1_PUBLIC=${SELF:h:h}
L0TH1_CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/l0th1
L0TH1_DATA=${XDG_DATA_HOME:-$HOME/.local/share}/l0th1
L0TH1_CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/l0th1
L0TH1_STATE=${XDG_STATE_HOME:-$HOME/.local/state}/l0th1
MACHINE=$L0TH1_CONFIG/machine.zsh
TS=$(date +%Y%m%d-%H%M%S)
BLOCK_BEGIN='# >>> l0th1-dot-env >>>'
BLOCK_END='# <<< l0th1-dot-env <<<'

L0TH1_HOST= L0TH1_PROFILES= L0TH1_OVERLAYS= L0TH1_VIM=1 L0TH1_ZELLIJ_THEME=
ZJ_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/zellij
[[ -r $MACHINE ]] && source $MACHINE

QUIET=0
info() { (( QUIET )) || print -P "%F{blue}==>%f $1" }
ok()   { print -P "  %F{green}ok%f   $1" }
warn() { print -P -u2 "  %F{yellow}warn%f $1" }
die()  { print -P -u2 "%F{red}error:%f $1"; exit 1 }

overlays() { print -rl -- ${(s.:.)L0TH1_OVERLAYS} }

repos() {
  local o
  print -r -- $L0TH1_PUBLIC
  for o in $(overlays); do [[ -d $o/.git ]] && print -r -- $o; done
}

available_profiles() {
  local o
  local -a dirs=( $L0TH1_PUBLIC/zsh/profiles/*(N/:t) )
  for o in $(overlays); do dirs+=( $o/zsh/profiles/*(N/:t) ); done
  print -r -- ${(u)dirs}
}

# Overlay repos cloned next to the public repo or under ~/.local/share/l0th1.
# Only used to suggest names: overlays are never enabled automatically.
detected_overlays() {
  local -a found=(
    ${L0TH1_PUBLIC:h}/${L0TH1_PUBLIC:t}-*(N/:t)
    ${L0TH1_PUBLIC:h}/l0th1-dot-env-*(N/:t)
    $L0TH1_DATA/*~*/(public|antidote|plugins)(N/:t)
  )
  found=( ${found#${L0TH1_PUBLIC:t}-} ); found=( ${found#l0th1-dot-env-} )
  print -r -- ${(u)found}
}

# Overlay name (or path) -> absolute repo path in $REPLY. Runs in the current
# shell (not $(...)) so that die really stops the install.
resolve_overlay() {
  local name=$1 c
  local -a candidates
  if [[ $name == */* ]]; then
    candidates=( $name )
  else
    candidates=( ${L0TH1_PUBLIC:h}/${L0TH1_PUBLIC:t}-$name ${L0TH1_PUBLIC:h}/l0th1-dot-env-$name $L0TH1_DATA/$name )
  fi
  for c in $candidates; do
    [[ -d $c/zsh || -d $c/vim ]] && { REPLY=${c:A}; return }
  done
  die "overlay '$name' not found (looked in: ${candidates[*]})"
}

# Move a file aside into this run's backup dir.
backup() {
  local target=$1 dir=$L0TH1_STATE/backups/$TS
  [[ -e $target || -L $target ]] || return 0
  local rel=${target#$HOME/} n=1
  local dest=$dir/$rel
  # Never overwrite an earlier backup of the same file from this run.
  while [[ -e $dest || -L $dest ]]; do dest=$dir/$rel.$((n++)); done
  mkdir -p ${dest:h} && mv $target $dest && info "backed up $target -> $dest"
}

# Symlink src -> dst. Returns 0 if it created the link, 1 if it was already in place.
link() {
  local src=$1 dst=$2
  [[ -L $dst && ${dst:A} == ${src:A} ]] && return 1
  backup $dst
  mkdir -p ${dst:h}
  ln -s $src $dst && info "linked $dst -> $src"
}

write_machine() {
  mkdir -p $L0TH1_CONFIG/local
  local extra=""
  # Keep any hand-added settings (lines that aren't the three managed keys).
  [[ -r $MACHINE ]] && extra=$(grep -vE '^(#|L0TH1_HOST=|L0TH1_PROFILES=|L0TH1_PRIVATE=|L0TH1_OVERLAYS=|L0TH1_VIM=|L0TH1_ZELLIJ_THEME=)' $MACHINE)
  {
    print -r -- "# l0th1 machine identity: written by \`l0th1 install\`, safe to edit."
    print -r -- "L0TH1_HOST=${(qq)L0TH1_HOST}"
    print -r -- "L0TH1_PROFILES=${(qq)L0TH1_PROFILES}"
    print -r -- "L0TH1_OVERLAYS=${(qq)L0TH1_OVERLAYS}"
    print -r -- "L0TH1_VIM=$L0TH1_VIM    # 0: leave ~/.vim alone (install --no-vim / --vim)"
    print -r -- "L0TH1_ZELLIJ_THEME=${(qq)L0TH1_ZELLIJ_THEME}    # default zellij theme (l0th1 zellij-theme NAME)"
    [[ -n $extra ]] && print -r -- $extra
  } >| $MACHINE
}

# Write (or refresh) the managed block in ~/.zshrc. Lines outside the block,
# for example ones installers append, are left alone.
install_zshrc() {
  local rc=${ZDOTDIR:-$HOME}/.zshrc
  local -a block=(
    $BLOCK_BEGIN
    "# Managed by \`l0th1 install\`. Machine settings: $L0TH1_CONFIG/machine.zsh"
    "# Local tweaks and secrets: $L0TH1_CONFIG/local/*.zsh (not in any repo)."
    "if [[ -r ${(qq)L0TH1_PUBLIC}/zsh/zshrc ]]; then"
    "  source ${(qq)L0TH1_PUBLIC}/zsh/zshrc"
    "else"
    "  print -u2 'l0th1: ${L0TH1_PUBLIC}/zsh/zshrc not found, run l0th1 install'"
    "fi"
    $BLOCK_END
  )
  local -a lines out
  if [[ -f $rc ]] && grep -qF -- $BLOCK_BEGIN $rc; then
    lines=( "${(@f)$(<$rc)}" )
    local skip=0 l
    for l in "${lines[@]}"; do
      if [[ $l == $BLOCK_BEGIN ]]; then out+=( $block ); skip=1; continue; fi
      if [[ $l == $BLOCK_END ]]; then skip=0; continue; fi
      (( skip )) || out+=( "$l" )
    done
    if [[ "${(F)out}" != "${(F)lines}" ]]; then
      print -r -- "${(F)out}" >| $rc
      info "refreshed l0th1 block in $rc"
    fi
  else
    backup $rc
    {
      print -r -- ${(F)block}
      print
      print -r -- "# Lines added below by other tools stay on this machine only."
    } >| $rc
    info "wrote $rc"
  fi
}

vim_plugins() {
  local cmd=$1
  (( $+commands[vim] )) || { warn "vim not installed, skipping plugins"; return }
  info "vim: $cmd"
  export L0TH1_HOST L0TH1_PROFILES L0TH1_OVERLAYS
  vim -N -u $L0TH1_PUBLIC/vim/vimrc -i NONE -es -c "$cmd" -c 'qa!' </dev/null
}

install_vim() {
  local fresh=0
  link $L0TH1_PUBLIC/vim $HOME/.vim && fresh=1
  # ~/.vimrc would shadow ~/.vim/vimrc.
  [[ -e $HOME/.vimrc || -L $HOME/.vimrc ]] && backup $HOME/.vimrc
  (( fresh || INSTALL_PLUGINS )) && vim_plugins 'PlugInstall --sync'
}

# ---------------------------------------------------------------- zellij

ZJ_MARK='// Generated by l0th1'

# Link every *.kdl under <repo>/zellij/ (public, then overlays: later wins)
# into ~/.config/zellij/, except config.kdl, which is generated: the public
# base config plus this machine's default theme.
install_zellij() {
  (( $+commands[zellij] )) || [[ -d $ZJ_DIR ]] || return 0
  local -A want
  local r zd f rel l
  for r in $L0TH1_PUBLIC $(overlays); do
    zd=$r/zellij
    [[ -d $zd ]] || continue
    for f in $zd/**/*.kdl(.N); do
      rel=${f#$zd/}
      [[ $rel == config.kdl ]] && continue
      want[$rel]=$f
    done
  done

  mkdir -p $ZJ_DIR
  for rel in ${(ok)want}; do
    mkdir -p ${${:-$ZJ_DIR/$rel}:h}
    link $want[$rel] $ZJ_DIR/$rel || true
  done

  # Remove links made by an earlier run that no repo provides any more (a file
  # deleted from a repo, or an overlay no longer enabled). The manifest lists
  # what we linked last time, so nothing else in ~/.config/zellij is touched.
  local manifest=$L0TH1_STATE/zellij-links
  if [[ -r $manifest ]]; then
    for rel in ${(f)"$(<$manifest)"}; do
      l=$ZJ_DIR/$rel
      (( ${+want[$rel]} )) && continue
      [[ -L $l ]] && rm -f -- $l && info "removed stale link $l"
    done
  fi
  mkdir -p $L0TH1_STATE
  print -rl -- ${(ok)want} >| $manifest

  write_zellij_config
  fetch_zjstatus
  write_zellij_layout
  if [[ -n $L0TH1_ZELLIJ_THEME && ! -e $ZJ_DIR/themes/$L0TH1_ZELLIJ_THEME.kdl ]]; then
    warn "zellij theme '$L0TH1_ZELLIJ_THEME' is not in any repo (fine if it is one of zellij's built-in themes)"
  fi
}

# The default layout's top bar is the zjstatus plugin (a wasm file, not kept
# in git): download it once if this machine does not have it yet.
fetch_zjstatus() {
  local w=$ZJ_DIR/plugins/zjstatus.wasm
  [[ -s $w ]] && return 0
  mkdir -p ${w:h}
  if curl -fsSL -o $w.tmp https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm; then
    mv $w.tmp $w && info "installed $w"
  else
    rm -f $w.tmp
    warn "could not download zjstatus; the default zellij layout needs $w"
  fi
}

# Fill the default-layout template with the colours of this machine's theme
# (ribbon_selected / ribbon_unselected / text_unselected), so the zjstatus bar
# matches what zellij's own tab bar would show. Without a readable theme file
# (none set, or a built-in one) it falls back to plain bold/reverse styling.
write_zellij_layout() {
  local tpl=$L0TH1_PUBLIC/zellij/default-layout.kdl.tpl out=$ZJ_DIR/layouts/default.kdl
  [[ -r $tpl ]] || return 0
  local tf=$ZJ_DIR/themes/$L0TH1_ZELLIJ_THEME.kdl
  local bar=bold tab=dim active=bold,reverse barbg=default tabbg=default actbg=default
  if [[ -n $L0TH1_ZELLIJ_THEME && -r $tf ]]; then
    local c
    # zj_col SECTION FIELD -> #rrggbb, from the first theme block that has it
    zj_col() {
      awk -v sec=$1 -v fld=$2 '$1==sec && $2=="{" {s=1; next} s && $1=="}" {s=0} s && $1==fld {printf "#%02x%02x%02x", $2,$3,$4; exit}' $tf
    }
    local bb=$(zj_col text_unselected background) bf=$(zj_col text_unselected base)
    local tf_=$(zj_col ribbon_unselected base) tb=$(zj_col ribbon_unselected background)
    local af=$(zj_col ribbon_selected base) ab=$(zj_col ribbon_selected background)
    if [[ -n $bb$bf$tf_$tb$af$ab && -n $bb && -n $bf && -n $tf_ && -n $tb && -n $af && -n $ab ]]; then
      bar="fg=$bf,bg=$bb"; tab="fg=$tf_,bg=$tb"; active="fg=$af,bg=$ab,bold"
      barbg=$bb; tabbg=$tb; actbg=$ab
    fi
    unfunction zj_col
  fi
  local new
  new="$ZJ_MARK from $tpl (theme ${L0TH1_ZELLIJ_THEME:-none}).
$(sed -e "s/@BAR@/$bar/g" -e "s/@TAB@/$tab/g" -e "s/@ACTIVE@/$active/g" -e "s/@BARBG@/$barbg/g" -e "s/@TABBG@/$tabbg/g" -e "s/@ACTBG@/$actbg/g" $tpl)"
  [[ -f $out && ! -L $out && "$(<$out)" == "$new" ]] && return 0
  mkdir -p ${out:h}
  [[ -e $out || -L $out ]] && ! grep -qF -- "$ZJ_MARK" $out 2>/dev/null && backup $out
  rm -f -- $out
  print -r -- "$new" >| $out
  info "wrote $out"
}

write_zellij_config() {
  local cfg=$ZJ_DIR/config.kdl last=$L0TH1_STATE/zellij-config.kdl base=$L0TH1_PUBLIC/zellij/config.kdl
  [[ -r $base ]] || return 0
  local new
  new=$(
    print -r -- "$ZJ_MARK from $base."
    print -r -- "// Edit that file, or run \`l0th1 zellij-theme NAME\`. Local edits are backed up and replaced."
    print
    print -r -- "$(<$base)"
    if [[ -n $L0TH1_ZELLIJ_THEME ]]; then
      print
      print -r -- "// This machine's default theme (L0TH1_ZELLIJ_THEME in $MACHINE)."
      print -r -- "theme \"$L0TH1_ZELLIJ_THEME\""
    fi
  )
  [[ -f $cfg && ! -L $cfg && "$(<$cfg)" == "$new" ]] && return 0
  # Keep a copy of anything not written by us (or edited since, e.g. by zellij's
  # configuration screen) before replacing it.
  if [[ -e $cfg || -L $cfg ]] && ! [[ -r $last && "$(<$cfg)" == "$(<$last)" ]]; then
    backup $cfg
  fi
  mkdir -p $L0TH1_STATE
  print -r -- "$new" >| $cfg
  print -r -- "$new" >| $last
  info "wrote $cfg${L0TH1_ZELLIJ_THEME:+ (theme $L0TH1_ZELLIJ_THEME)}"
}

cmd_zellij_theme() {
  if (( ! $# )); then
    local -a themes=( $ZJ_DIR/themes/*.kdl(N:t:r) )
    print -r -- "default theme: ${L0TH1_ZELLIJ_THEME:-<zellij default>}"
    print -r -- "themes from the repos: ${themes[*]:-none}"
    print -r -- "set with: l0th1 zellij-theme NAME   (or 'none' for zellij's default)"
    return
  fi
  (( $+commands[zellij] )) || [[ -d $ZJ_DIR ]] || die "zellij is not installed here"
  cmd_install --quiet --zellij-theme $1
  QUIET=0
  info "zellij theme: ${L0TH1_ZELLIJ_THEME:-zellij default}. Running sessions switch to it live."
}

# ---------------------------------------------------------------- commands

cmd_install() {
  local host=$L0TH1_HOST profiles=$L0TH1_PROFILES overlays_arg= o
  local profiles_given=0
  INSTALL_PLUGINS=0
  while (( $# )); do
    case $1 in
      --host)       host=$2; shift 2 ;;
      --profiles)   profiles=$2; profiles_given=1; shift 2 ;;
      --overlays)   overlays_arg=$2; shift 2 ;;
      --no-vim)     L0TH1_VIM=0; shift ;;
      --vim)        L0TH1_VIM=1; shift ;;
      --zellij-theme) [[ $2 == none ]] && L0TH1_ZELLIJ_THEME= || L0TH1_ZELLIJ_THEME=$2; shift 2 ;;
      --plugins)    INSTALL_PLUGINS=1; shift ;;
      --quiet)      QUIET=1; shift ;;
      -h|--help)    usage; return ;;
      *)            die "install: unknown option $1" ;;
    esac
  done

  [[ -n $host ]] || host=${HOST%%.*}
  if [[ -n $overlays_arg ]]; then
    local -a resolved=()
    if [[ $overlays_arg != none ]]; then
      for o in ${=overlays_arg}; do resolve_overlay $o; resolved+=( $REPLY ); done
    fi
    L0TH1_OVERLAYS=${(j.:.)resolved}
  elif [[ ! -r $MACHINE ]]; then
    local found=$(detected_overlays)
    [[ -n $found ]] && warn "overlays found on disk but not enabled: $found. Use --overlays \"...\"."
  fi

  L0TH1_HOST=$host L0TH1_PROFILES=$profiles

  local p known=" $(available_profiles) "
  for p in ${=L0TH1_PROFILES}; do
    [[ $known == *" $p "* ]] || warn "profile '$p' has no directory in either repo"
  done
  if [[ -z $L0TH1_PROFILES && $profiles_given == 0 ]]; then
    warn "no profiles set. Available: $(available_profiles). Use --profiles \"desktop dev\"."
  fi

  write_machine
  mkdir -p $L0TH1_STATE $L0TH1_CACHE $L0TH1_CONFIG/local
  link $SELF $HOME/.local/bin/l0th1 || true
  install_zshrc
  (( L0TH1_VIM )) && install_vim
  install_zellij

  local names=( $(overlays) ); names=( ${${names:t}#${L0TH1_PUBLIC:t}-} ); names=( ${names#l0th1-dot-env-} )
  info "host=%B$L0TH1_HOST%b profiles=%B${L0TH1_PROFILES:-<none>}%b overlays=%B${names[*]:-<none>}%b"
  info "done. Open a new shell (first start downloads zsh plugins)."
}

cmd_update() {
  local plugins=0 r failed=0
  [[ ${1:-} == --plugins ]] && plugins=1
  for r in $(repos); do
    info "pull ${r:t}"
    if ! git -C $r pull --ff-only --quiet; then
      warn "pull failed in $r (local changes or diverged history?)"
      failed=1
    fi
  done
  mkdir -p $L0TH1_STATE && print 0 >| $L0TH1_STATE/behind
  # Pick up layout changes (moved repo, new stub format, zellij files). Run the
  # freshly pulled l0th1 in a new process: this one still has the old code loaded.
  $SELF install --quiet || failed=1
  if (( plugins )); then
    info "zsh plugins: antidote update"
    zsh -c "export ANTIDOTE_HOME=${(q)L0TH1_DATA}/plugins; zstyle ':antidote:bundle' use-friendly-names on;
            source ${(q)L0TH1_DATA}/antidote/antidote.zsh && antidote update" || failed=1
    vim_plugins 'PlugUpdate --sync'
  fi
  (( failed )) && return 1
  info "updated. Open a new shell (or run: exec zsh)."
}

# Background check used by the shell's update notice.
cmd_check() {
  local r n total=0
  export GIT_TERMINAL_PROMPT=0
  for r in $(repos); do
    # GIT_SSH_COMMAND overrides core.sshCommand, so build on the repo's own
    # (a deploy key set by `l0th1 deploy-key`).
    GIT_SSH_COMMAND="$(git -C $r config core.sshCommand || print ssh) -o BatchMode=yes -o ConnectTimeout=5" \
      git -C $r fetch --quiet 2>/dev/null || continue
    n=$(git -C $r rev-list --count 'HEAD..@{u}' 2>/dev/null) || n=0
    (( total += n ))
  done
  mkdir -p $L0TH1_STATE && print $total >| $L0TH1_STATE/behind
  print $total
}

cmd_status() {
  print -P "%Bmachine%b  host=$L0TH1_HOST  os=$OSTYPE  profiles=${L0TH1_PROFILES:-<none>}"
  local r branch dirty ab
  for r in $(repos); do
    branch=$(git -C $r rev-parse --abbrev-ref HEAD 2>/dev/null)
    dirty=$(git -C $r status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    ab=$(git -C $r rev-list --left-right --count 'HEAD...@{u}' 2>/dev/null | awk '{print "ahead " $1 ", behind " $2}')
    print -P "%Brepo%b     $r  [$branch] ${ab:-no upstream}, $dirty uncommitted change(s)"
  done
}

cmd_doctor() {
  local rc=${ZDOTDIR:-$HOME}/.zshrc problems=0
  print -P "%Bl0th1 doctor%b ($L0TH1_HOST)"
  [[ -r $MACHINE ]] && ok "machine config $MACHINE" || { warn "no $MACHINE: run l0th1 install"; problems=1 }
  grep -qF -- $BLOCK_BEGIN $rc 2>/dev/null && ok "$rc has the l0th1 block" || { warn "$rc has no l0th1 block"; problems=1 }
  local v=$HOME/.vim want=$L0TH1_PUBLIC/vim
  [[ -L $v && ${v:A} == ${want:A} ]] && ok "~/.vim -> repo" || warn "~/.vim is not linked to $L0TH1_PUBLIC/vim"
  [[ -e $HOME/.vimrc ]] && warn "~/.vimrc exists and shadows ~/.vim/vimrc"
  [[ -r $L0TH1_DATA/antidote/antidote.zsh ]] && ok "antidote installed" || warn "antidote missing (installed on next shell start)"
  local o
  for o in $(overlays); do
    [[ -d $o ]] && ok "overlay $o" || { warn "overlay $o missing"; problems=1 }
  done
  [[ -z $L0TH1_OVERLAYS ]] && ok "no overlays (public only)"
  [[ -d $L0TH1_CONFIG/local ]] && ok "local overrides dir $L0TH1_CONFIG/local"
  local t
  for t in git zsh vim; do (( $+commands[$t] )) && ok "$t found" || { warn "$t not found"; problems=1 }; done
  path=( $HOME/.local/bin $HOME/.atuin/bin $path )
  for t in atuin autojump gpgconf; do (( $+commands[$t] )) || print -P "  %F{8}info%f $t not installed (optional)"; done
  local old
  for old in $rc ${L0TH1_CONFIG}/local/*.zsh(N); do
    grep -q 'zplug' $old 2>/dev/null && warn "$old still mentions zplug (the old plugin manager)"
  done
  zsh -n $L0TH1_PUBLIC/zsh/zshrc && ok "zshrc syntax"
  if (( $+commands[zellij] )); then
    if grep -qF -- "$ZJ_MARK" $ZJ_DIR/config.kdl 2>/dev/null; then
      ok "zellij config generated (theme: ${L0TH1_ZELLIJ_THEME:-zellij default})"
    else
      warn "$ZJ_DIR/config.kdl is not managed by l0th1: run l0th1 install"
    fi
    [[ -n $L0TH1_ZELLIJ_THEME && ! -e $ZJ_DIR/themes/$L0TH1_ZELLIJ_THEME.kdl ]] &&
      print -P "  %F{8}info%f zellij theme '$L0TH1_ZELLIJ_THEME' is not in the repos (fine if it is built in)"
  fi
  return $problems
}

cmd_push_all() {
  local dry=0 fwd=() only=()
  while (( $# )); do
    case $1 in
      --dry-run) dry=1 ;;
      --forward-agent) fwd=(-A) ;;
      -*) die "push-all: unknown option $1" ;;
      *) only+=( $1 ) ;;
    esac
    shift
  done
  # Each overlay lists its own machines, so this machine only knows the hosts
  # of the overlays it has.
  local -a lists=( ${^${(f)"$(overlays)"}}/machines.txt(N.) )
  (( $#lists )) || die "no machines.txt in any overlay"

  # Remote machines pull from the git remote, so local commits must be pushed first.
  local r
  for r in $(repos); do
    if [[ -n $(git -C $r status --porcelain 2>/dev/null) ]] ||
       (( $(git -C $r rev-list --count '@{u}..HEAD' 2>/dev/null || print 0) > 0 )); then
      warn "${r:t} has uncommitted or unpushed changes; other machines won't see them"
    fi
  done

  local line target name failed=() seen=()
  for line in "${(@f)$(cat $lists | grep -vE '^[[:space:]]*(#|$)')}"; do
    target=${${=line}[1]} name=${${=line}[2]:-$target}
    [[ -n $target ]] || continue
    [[ $name == $L0TH1_HOST || ${seen[(Ie)$name]} -gt 0 ]] && continue
    (( $#only )) && (( ! ${only[(Ie)$name]} )) && continue
    seen+=( $name )
    info "$target"
    (( dry )) && { print "  would run: ssh $fwd $target '~/.local/bin/l0th1 update'"; continue }
    ssh $fwd -o BatchMode=yes -o ConnectTimeout=5 $target '~/.local/bin/l0th1 update' 2>&1 \
      | sed "s/^/  [$name] /" || failed+=( $name )
  done
  (( $#failed )) && { warn "failed: ${failed[*]}"; return 1 }
  return 0
}

# Give an overlay repo its own SSH key (a GitHub deploy key: read-only, one
# repo per key). Stored as core.sshCommand in the repo's .git/config, so every
# git command in that repo uses it, whatever ssh agent is (or isn't) around.
cmd_deploy_key() {
  local name=${1:-} key=${2:-}
  [[ -n $name ]] || die "usage: l0th1 deploy-key OVERLAY [KEYFILE]"
  resolve_overlay $name
  local repo=$REPLY; name=${repo:t}; name=${name#l0th1-dot-env-}
  [[ -n $key ]] || key=$HOME/.ssh/l0th1-${name}_ed25519
  key=${key:A}
  if [[ ! -f $key ]]; then
    mkdir -p -m 700 ${key:h}
    ssh-keygen -q -t ed25519 -N '' -C "l0th1 $name deploy key @ $L0TH1_HOST" -f $key || die "ssh-keygen failed"
    info "created $key"
  fi
  git -C $repo config core.sshCommand "ssh -i ${(q)key} -o IdentitiesOnly=yes"
  info "${repo:t}: git now uses $key"

  local url=$(git -C $repo remote get-url origin 2>/dev/null)
  [[ $url == (git@|ssh://)* ]] || warn "remote is $url: deploy keys only apply to ssh remotes (git@github.com:...)"
  if GIT_SSH_COMMAND="ssh -i ${(q)key} -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=5" \
      git -C $repo ls-remote --quiet origin HEAD >/dev/null 2>&1; then
    ok "key accepted by origin"
  else
    local slug=${${url#*github.com[:/]}%.git}
    print "\nAdd this public key as a deploy key (read-only)${slug:+ at https://github.com/$slug/settings/keys}:\n"
    cat $key.pub
    print "\nThen check with: l0th1 update"
  fi
}

usage() {
  cat <<EOF
l0th1: manage l0th1-dot-env on this machine

  l0th1 install [--host NAME] [--profiles "p1 p2"] [--overlays "o1 o2"|none] [--no-vim|--vim] [--plugins]
                [--zellij-theme NAME|none]
      Write ~/.config/l0th1/machine.zsh, the ~/.zshrc block and the ~/.vim link.
      Safe to re-run; anything it replaces is moved to $L0TH1_STATE/backups/.
  l0th1 update [--plugins]     git pull all repos (fast-forward only), refresh links;
                              --plugins also updates zsh and vim plugins
  l0th1 status                 machine identity and repo state
  l0th1 doctor                 check the installation
  l0th1 check                  fetch and count upstream commits (the shell runs this daily)
  l0th1 zellij-theme [NAME|none]
                              show or set this machine's default zellij theme
                              (running sessions switch live)
  l0th1 deploy-key OVERLAY [KEYFILE]
                              make git use its own SSH key for that overlay (created as
                              ~/.ssh/l0th1-OVERLAY_ed25519 if missing); prints the public
                              key to add as a GitHub deploy key
  l0th1 push-all [--dry-run] [--forward-agent] [host...]
                              run 'l0th1 update' on every host in the overlays' machines.txt
                              (or only the named ones)

Profiles available here: $(available_profiles)
EOF
}

case ${1:-help} in
  install)  shift; cmd_install "$@" ;;
  update)   shift; cmd_update "$@" ;;
  check)    shift; cmd_check "$@" ;;
  status)   shift; cmd_status "$@" ;;
  doctor)   shift; cmd_doctor "$@" ;;
  push-all) shift; cmd_push_all "$@" ;;
  deploy-key) shift; cmd_deploy_key "$@" ;;
  zellij-theme) shift; cmd_zellij_theme "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
